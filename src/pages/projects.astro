---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="Chess Analysis Platform"
    img="/project-chess.webp"
    desc="A Python-based chess analysis project that uses the Stockfish engine to evaluate games, stores them in a local database, and surfaces insights through an interactive HTML dashboard."
    url="https://github.com/grantp12/chess-project"
    badge="NEW"
  />
</BaseLayout>
