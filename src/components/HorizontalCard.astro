---
import { Image } from "astro:assets";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);

interface Props {
  title: string;
  img?: string;
  desc: string;
  url: string;
  badge?: string;
  tags?: string[];
  date?: Date;
  target?: string;
}

const { title, img, desc, url, badge, tags, date, target = "_blank" } = Astro.props;
---

<div
  class="relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="max-w-full md:max-w-52 rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <h2 class="text-xl font-bold">
        <!-- The title link stretches over the whole card, so the card stays clickable
             without wrapping the tag links inside another link. -->
        <a href={url} target={target} class="after:absolute after:inset-0">{title}</a>{" "}
        {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
      </h2>
      {date && <time class="text-sm opacity-60" datetime={dayjs(date).format("YYYY-MM-DD")}>{dayjs(date).format("ll")}</time>}
      <p class="py-1 text-1xl">{desc}</p>
      {
        tags && (
          <div class="card-actions justify-end relative z-10">
            {tags.map((tag) => (
              <a href={`/blog/tag/${tag}/`} class="badge badge-outline">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
